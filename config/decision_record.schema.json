{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/sidd91/softwareDefinedVessels/config/decision_record.schema.json",
  "title": "ArgOS decision record",
  "description": "One record per decision (ARCHITECTURE contract 6). Every screen line, the event log, the replay check and the sentence read this record. Times are ship time; wall-clock latency is in the separate timing log, never here, so a replay reproduces records byte for byte.",
  "type": "object",
  "required": ["seq", "tick", "t_s", "kind", "subject", "verdict", "sentence", "inputs_hash"],
  "additionalProperties": false,
  "properties": {
    "seq": {"type": "integer", "minimum": 0},
    "tick": {"type": "integer", "minimum": 0},
    "t_s": {"type": "number", "description": "Ship time of the snapshot the decision read"},
    "applies_at_tick": {"type": "integer", "description": "Tick at which its commands are applied (the next tick)"},
    "kind": {"enum": ["D1", "D2", "D3", "D4", "D5"]},
    "subject": {"type": "string"},
    "mission": {"type": "string"},
    "verdict": {"enum": ["yes", "yes-if", "no", "not-now", "card-rejected", "proceeds", "hold", "shed", "unconfirmed", "confirm", "standing_plan", "automatic", "forbidden", "held", "cleared"]},
    "binding": {"$ref": "#/$defs/line"},
    "also_failing": {"type": "array", "items": {"$ref": "#/$defs/line"}},
    "options": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["remove", "value_lost", "mission_critical"],
      "properties": {"remove": {"type": "array", "items": {"type": "string"}}, "value_lost": {"type": "number"}, "mission_critical": {"type": "boolean"},
        "mass_after_t": {"type": "number"}, "moves": {"type": "object", "additionalProperties": {"type": "string"}}}}},
    "placement": {"type": "object", "additionalProperties": {"type": ["string", "null"]}},
    "genset": {"type": "object", "additionalProperties": false, "required": ["load_kw", "reserve_kw", "gate_kw", "state"],
      "properties": {"load_kw": {"type": "number"}, "reserve_kw": {"type": "number"}, "gate_kw": {"type": "number"},
        "state": {"enum": ["fits", "holds_by_throttling", "does_not_hold"]}, "steps": {"type": "array", "items": {"$ref": "#/$defs/step"}}}},
    "seawater_tip_c": {"type": ["number", "null"]},
    "steps": {"type": "array", "items": {"$ref": "#/$defs/step"}},
    "armed": {"type": "array", "items": {"$ref": "#/$defs/step"}},
    "order_source": {"enum": ["computed", "declared"]},
    "losses": {"type": "object", "additionalProperties": {"type": "object", "additionalProperties": false,
      "required": ["mode_before", "mode_after", "capability_before", "capability_after"],
      "properties": {"mode_before": {"type": "string"}, "mode_after": {"type": "string"}, "capability_before": {"type": "number"}, "capability_after": {"type": "number"}}}},
    "load_kw": {"type": "number"},
    "limit_kw": {"type": "number"},
    "load_after_kw": {"type": "number"},
    "proceeds": {"type": "string"},
    "yields": {"type": "string"},
    "hard_limit": {"type": "object"},
    "deadline_t_s": {"type": ["number", "null"]},
    "conflicts": {"type": "array", "items": {"type": "object"}},
    "reserved": {"type": "object", "additionalProperties": {"type": "number"}},
    "cost_to_loser": {"type": "object", "additionalProperties": false, "required": ["guest", "minutes_lost", "open_ended"],
      "properties": {"guest": {"type": "string"}, "minutes_lost": {"type": "array", "items": {"type": "number"}, "minItems": 2, "maxItems": 2},
        "open_ended": {"type": "boolean"}, "leg": {"type": "string"}, "holds": {"type": "string"}}},
    "rule": {"type": "string"},
    "crew_aboard": {"type": "integer"},
    "deck_evidence": {"type": "string"},
    "raw_event_t_s": {"type": ["number", "null"]},
    "confirmed_t_s": {"type": ["number", "null"]},
    "first_shed_due_t_s": {"type": ["number", "null"]},
    "trigger": {"type": "string"},
    "injected": {"type": "boolean"},
    "field": {"type": "string", "description": "CARD REJECTED: the field that failed"},
    "inputs_hash": {"type": "string", "pattern": "^[0-9a-f]{16}$"},
    "sentence": {"type": "string", "minLength": 1}
  },
  "$defs": {
    "line": {"type": "object", "additionalProperties": false, "required": ["class", "label", "capacity", "demand", "free", "unit"],
      "properties": {"class": {"type": "string"}, "label": {"type": "string"}, "capacity": {"type": "number"}, "demand": {"type": "number"},
        "free": {"type": "number"}, "unit": {"type": "string"}, "degraded_by": {"type": "array", "items": {"type": "string"}}}},
    "step": {"type": "object", "additionalProperties": false, "required": ["guest", "from_mode", "to_mode", "frees_kw"],
      "properties": {"guest": {"type": "string"}, "from_mode": {"type": "string"}, "to_mode": {"type": "string"}, "frees_kw": {"type": "number"},
        "cost_per_kw": {"type": "number"}, "capability_lost_pct": {"type": "number"}, "mission_critical": {"type": "boolean"}, "shed": {"type": "boolean"}}}
  }
}
